import requests
from bs4 import BeautifulSoup

# LINE token
LINE_CHANNEL_ACCESS_TOKEN = "等等會改"

# LINE userId
LINE_USER_ID = "等等會改"

KEYWORDS = [
    "AI",
    "人工智慧",
    "資訊",
    "系統",
    "網站",
    "軟體"
]

def fetch_cases():
    url = "https://www.taiwanbuying.com.tw/"

    response = requests.get(url)
    response.encoding = "big5"

    soup = BeautifulSoup(response.text, "html.parser")

    text = soup.get_text("\n")

    results = []

    for line in text.splitlines():
        line = line.strip()

        if not line:
            continue

        for keyword in KEYWORDS:
            if keyword in line:
                results.append(line)
                break

    return results[:10]

def send_line_message(message):
    url = "https://api.line.me/v2/bot/message/push"

    headers = {
        "Authorization": f"Bearer {LINE_CHANNEL_ACCESS_TOKEN}",
        "Content-Type": "application/json"
    }

    data = {
        "to": LINE_USER_ID,
        "messages": [
            {
                "type": "text",
                "text": message
            }
        ]
    }

    response = requests.post(
        url,
        headers=headers,
        json=data
    )

    print(response.text)

def main():
    cases = fetch_cases()

    if not cases:
        message = "今天沒有符合條件的採購案"
    else:
        message = "今日採購案通知：\n\n"

        for i, case in enumerate(cases, 1):
            message += f"{i}. {case}\n\n"

    send_line_message(message)

if __name__ == "__main__":
    main()
